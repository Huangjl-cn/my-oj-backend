# 生产部署环境变量模板：复制为 deploy/.env 后填写（.env 已被 gitignore，不得提交）。
# docker compose 自动读取同目录的 .env；任何一项缺失，compose 都会直接报错退出。

# MySQL root 密码（秘密）。只用于数据库运维，应用不使用 root
MYSQL_ROOT_PASSWORD=

# 应用数据库账号 oj_app 的密码（秘密），不要与 root 密码相同。
# 首次初始化数据卷时由 mysql 镜像创建该账号
MYSQL_PASSWORD=

# 代码沙箱地址，不带 /executeCode 后缀，例如 http://10.0.0.2:8100
CODESANDBOX_URL=

# 沙箱调用签名的 key-id，必须与沙箱生产配置的 key-id 一致，例如 sandbox-key-prod-2026
CODESANDBOX_AUTH_KEY_ID=

# 沙箱调用签名私钥（秘密）：Base64 编码的 PKCS#8 EC P-256 私钥，生成方法见 docs/sandbox-auth/README.md
CODESANDBOX_AUTH_PRIVATE_KEY=
